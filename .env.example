# Copy to .env.local and fill in. Nothing here is required for Phase 1.
# Validated in src/lib/env.ts (from Phase 2 onward).

# --- App ---
NEXT_PUBLIC_ROOT_DOMAIN=nexusdispatch.com
# Set to "true" to expose /design-system in a production build.
NEXT_PUBLIC_ENABLE_DESIGN_SYSTEM=false
# Used to build the password-reset email link (Phase 3). Local dev default
# below is correct for `npm run dev`; set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 2/3) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox (Phase 4) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Stripe (Phase 5) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (Phase 3) ---
RESEND_API_KEY=

# --- Cloudflare R2 / ePOD (Phase 5) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
